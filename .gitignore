# Node (future)
node_modules/

# Reaper — the session file (.rpp) IS committed; these are not
*.rpp-bak
*.reapeaks
reaper/media/
reaper/Media/
reaper/Backups/
reaper/AutoSaves/

# Composer score — canonical scores/*.json ARE committed; safety-net versions are not
scores/versions/
# ...and neither are the D10 working copies: autosave rewrites piece-sNN-work
# every 5 seconds, so tracking them would be pure churn. The canonical file is
# what gets committed, via "Save as next".
scores/*-work.json

# Generator OUTPUT is derivable, so it is not committed: gen-aud-*.json are
# rendered byte-for-byte by tools/trance_gen*.py from a fixed seed (12 MB of
# audition material that regenerates in about a second). Everything else in
# scores/ IS committed -- including the composer's working sketches, because
# autosave has eaten a score three times and git is the only net under it.
scores/gen-aud-*.json

# OS noise
Thumbs.db
.DS_Store
research/audio/*.wav
research/audio/*.flac

probes/_selftest_render.wav
probes/last_bend_analysis.json
