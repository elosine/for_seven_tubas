# Node (future)
node_modules/

# Reaper — the session file (.rpp) IS committed; these are not
*.rpp-bak
*.reapeaks
reaper/media/
reaper/Media/
reaper/Backups/
reaper/AutoSaves/

# Composer score — canonical scores/*.json ARE committed; safety-net versions are not
scores/versions/
# ...and neither are the D10 working copies: autosave rewrites piece-sNN-work
# every 5 seconds, so tracking them would be pure churn. The canonical file is
# what gets committed, via "Save as next".
scores/*-work.json

# Generator OUTPUT is derivable, so it is not committed: gen-aud-*.json are
# rendered byte-for-byte by tools/trance_gen*.py from a fixed seed (12 MB of
# audition material that regenerates in about a second). Everything else in
# scores/ IS committed -- including the composer's working sketches, because
# autosave has eaten a score three times and git is the only net under it.
scores/gen-aud-*.json

# OS noise
Thumbs.db
.DS_Store
research/audio/*.wav
research/audio/*.flac

probes/_selftest_render.wav
probes/last_bend_analysis.json

# FONTS ARE NOT COMMITTED (day 36). This repo is PUBLIC, and a font file is
# licensed SOFTWARE -- putting one here republishes it to the world, which no
# desktop font licence permits (not even a purchased one: a desktop licence
# covers installs, not redistribution). The printed score is unaffected --
# typeset output contains no font and, in the US, typeface DESIGNS are not
# copyrightable at all; only the font software is.
# The cover face is Bitstream's EngraversGothic BT -- see docs/FONTS.md.
fonts/

# Video renders — derivable from tools/export_video.js + the WAV, and huge.
# notation/video/cut-list.json IS committed (small data, seeded, reproducible).
notation/video/**/*.mp4
notation/video/**/*.png
notation/video/**/*.rgba
notation/video/test/
notation/video/probe/

# Print score — derivable from tools/export_print.js in ~3 s, and large.
# print/cover/ IS committed (the SVG sources and the generator).
print/score/*.pdf
print/score/*.__print.html
